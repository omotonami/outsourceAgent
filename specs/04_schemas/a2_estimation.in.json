{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "a2_estimation input",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "business_context": {
      "type": "object"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "tech_stack": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "project_id",
    "modules"
  ],
  "additionalProperties": false
}
