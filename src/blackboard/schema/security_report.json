{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "findings",
    "gate"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "severity"
        ],
        "properties": {
          "severity": {
            "enum": [
              "Low",
              "Medium",
              "High",
              "Critical"
            ]
          }
        }
      }
    },
    "gate": {
      "enum": [
        "pass",
        "block"
      ]
    }
  }
}
