{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "b2_ux output",
  "type": "object",
  "properties": {
    "flows": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "story_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "purpose",
          "states"
        ],
        "additionalProperties": false
      }
    },
    "a11y_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "flows",
    "screens"
  ],
  "additionalProperties": false
}
